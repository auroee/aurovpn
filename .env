# =============================================================================
# AURO VPN BOT — ПОЛНЫЙ .env
# Все переменные в одном месте. Комментарии — что, зачем, как получить.
# Секреты в git НЕ коммитить. В проде — через secret manager / systemd EnvironmentFile.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. TELEGRAM
# -----------------------------------------------------------------------------
# Токен бота из @BotFather. В исходниках был скомпрометирован — отозвать и выпустить новый!
BOT_TOKEN=9085570055:AAGv1SaYFf6qEAV6bjT0kKaQ_JgbDv6C2hg

# Username бота (без @). Нужен для сборки реферальной ссылки t.me/<username>?start=ref_<code>
BOT_USERNAME=aurovpn_bot

# Секретный заголовок для вебхука Telegram (X-Telegram-Bot-Api-Secret-Token).
# Сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET_TG=replace_with_random_32_bytes_base64

# Админы (числовые Telegram ID через запятую). Из файла: 9119174705, 5686392491
# Роль «Владелец» — OWNER_ID; остальные — по умолчанию «Поддержка».
ADMIN_IDS=9119174705,5686392491
OWNER_ID=9119174705

# Канал (ID из файла — 4417547852). Используется только для кнопки «Канал» в «О сервисе».
CHANNEL_ID=4417547852
CHANNEL_URL=https://t.me/aurochannel

# -----------------------------------------------------------------------------
# 2. БАЗА ДАННЫХ
# -----------------------------------------------------------------------------
# PostgreSQL (рекомендуется). Формат для asyncpg (SQLAlchemy 2):
# postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Для локальной разработки можно SQLite: sqlite+aiosqlite:///./auro.db
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aurovpn

# Пул соединений
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# 3. ПУБЛИЧНЫЙ АДРЕС И ВЕБХУКИ
# -----------------------------------------------------------------------------
# Публичный HTTPS-адрес, на который Telegram/Platega/AdaptGroup шлют вебхуки.
# Из файла: aurovpn.cc.cd (нужен HTTPS-терминатор: nginx/Caddy/Cloudflare Tunnel).
PUBLIC_BASE_URL=https://aurovpn.cc.cd

# Пути эндпоинтов (менять не обязательно — совпадают с main.py)
TELEGRAM_WEBHOOK_PATH=/tg/webhook
PLATEGA_WEBHOOK_PATH=/platega/webhook
ADAPTGROUP_WEBHOOK_PATH=/adaptgroup/webhook

# HTTP-сервер (FastAPI/uvicorn)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# -----------------------------------------------------------------------------
# 4. PLATEGA (СБП)
# -----------------------------------------------------------------------------
# Документация: https://app.platega.io (см. кабинет мерчанта)
# В исходных файлах MerchantId и Secret НЕ БЫЛИ УКАЗАНЫ — запросить у Platega!
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=your_merchant_id_here
PLATEGA_SECRET=your_secret_here

# Метод оплаты: 2 = СБП (по документации Platega)
PLATEGA_PAYMENT_METHOD=2

# Куда вернуть пользователя после оплаты (обычно — в бота)
PLATEGA_RETURN_URL=https://t.me/aurovpn_bot

# Таймаут HTTP-клиента к Platega (сек)
PLATEGA_HTTP_TIMEOUT=20

# -----------------------------------------------------------------------------
# 5. ADAPTGROUP (VPN)
# -----------------------------------------------------------------------------
# Документация: https://docs.adaptgroup.pro/docs/api-vpn/adaptgroup-vpn-api
# API ID из файла: 173 (используется в заголовке X-Api-Key? см. документацию)
ADAPT_API_ID=173

# API-ключ (X-Api-Key). В исходниках скомпрометирован — отозвать и выпустить новый!
ADAPT_API_KEY=ADAPT7PHJ2775ZKHJSIEQ4ZMED4H5TRJLI3Z3MZLQFK7XWMTAPVFQ54IQVPN

ADAPT_BASE_URL=https://network-api.adaptgroup.app

# Маппинг локальных кодов каталога → планы AdaptGroup (по файлу aurovpn_инфо.txt)
ADAPT_PLAN_14D=plan_14d
ADAPT_PLAN_1M=plan_1m
ADAPT_PLAN_3M=plan_3m
ADAPT_PLAN_6M=plan_6m
ADAPT_PLAN_1Y=plan_1y

# Базовый URL персональных подписок (из файла). Используется только для справки/логов:
# фактическая ссылка приходит из API AdaptGroup, из ID её не собираем.
ADAPT_SUB_BASE=https://conf.now/sub/

# HMAC-SHA256 секрет для проверки входящих вебхуков AdaptGroup (X-Webhook-Signature)
# Должен совпадать с настройкой в дашборде AdaptGroup.
ADAPT_WEBHOOK_SECRET=replace_with_adapt_webhook_secret

# IP allowlist для вебхуков AdaptGroup (по документации: 199.89.134.2). Пусто — не проверять.
ADAPT_IP_ALLOW=199.89.134.2

# Таймаут HTTP-клиента к AdaptGroup (сек)
ADAPT_HTTP_TIMEOUT=25

# JSON-маппинг для main.py (собирается из ADAPT_PLAN_* выше, но здесь явно — на случай ручной правки)
ADAPTGROUP_PLAN_MAP={"plan_14d":"plan_14d","plan_1m":"plan_1m","plan_3m":"plan_3m","plan_6m":"plan_6m","plan_1y":"plan_1y"}

# -----------------------------------------------------------------------------
# 6. ПРОДУКТ
# -----------------------------------------------------------------------------
# Рефералка
REFERRAL_PERCENT=15
REFERRAL_HOLD_HOURS=24

# Пополнение
TOPUP_MIN=50
TOPUP_MAX=10000

# Время жизни заказа на оплату (мин). Точный срок берётся из ответа Platega, это — fallback.
ORDER_TTL_MINUTES=20

# Технический режим: true — новые покупки отключены, оплаченные заказы обрабатываются
MAINTENANCE=false

# -----------------------------------------------------------------------------
# 7. ЮРИДИЧЕСКИЕ ССЫЛКИ
# -----------------------------------------------------------------------------
TERMS_URL=https://telegra.ph/Auro-VPN--Usloviya-servisa-11-23
PRIVACY_URL=https://telegra.ph/Auro-VPN--Konfidencialnost-11-23

# Версия документов (для user_acceptances). Меняется при публикации новой редакции.
TERMS_VERSION=2024-11-23
PRIVACY_VERSION=2024-11-23

# -----------------------------------------------------------------------------
# 8. ЛОГИ И МОНИТОРИНГ (опционально)
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=
# Порт /metrics (Prometheus). Пусто — выключено.
METRICS_PORT=9101

# -----------------------------------------------------------------------------
# 9. ФОНОВЫЕ ЗАДАЧИ
# -----------------------------------------------------------------------------
# Интервал цикла обработчика заказов (сек)
WORKER_INTERVAL=15
# Сколько попыток выполнения заказа до перевода в MANUAL
FULFILLMENT_MAX_ATTEMPTS=5
